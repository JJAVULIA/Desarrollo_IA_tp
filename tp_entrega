"""Ejercicio 17
Crear una clase `Sensor` con los atributos `nombre` y `mediciones`. Incorporar métodos para registrar una 
medición, calcular el promedio y devolver el estado del sensor."""

class Sensor:
    # 1. El constructor de la clase inicializa los atributos obligatorios
    def __init__(self, nombre_del_objeto):
        self.nombre = nombre_del_objeto
        self.mediciones = []  # Arranca como una lista vacía para almacenar los datos

    # 2. Método para registrar una nueva medición en la lista usando .append()
    def registrar_medicion(self, valor):
        self.mediciones.append(valor)

    # 3. Método para calcular el promedio de las mediciones registradas
    def calcular_promedio(self):
        # Si la lista está vacía, evitamos dividir por cero devolviendo None
        if len(self.mediciones) == 0:
            return None
        return sum(self.mediciones) / len(self.mediciones)

    # 4. Método para armar un texto resumen con el estado del objeto
    def devolver_estado(self):
        prom = self.calcular_promedio()
        if prom is None:
            return f"Sensor {self.nombre}: No registra mediciones aún."
        return f"Sensor {self.nombre} | Promedio: {prom:.2f}°C | Historial: {self.mediciones}"

"""8. Ejercicio integrador
A partir de la clase Sensor definida anteriormente, desarrollar un programa que:
- Represente mediante una matriz de NumPy las mediciones realizadas por tres sensores. 
Cada fila deberá corresponder a un sensor y cada columna, a una medición.
- Recorra las filas de la matriz utilizando range().
- Cree un objeto Sensor por cada fila y registre en él todas sus mediciones.
- Almacene los objetos creados en una lista.
- Recorra la lista de sensores y obtenga, para cada uno, su nombre, su promedio y su estado."""

# Matriz de NumPy proporcionada
mediciones_matriz = np.array([
    [24.0, 25.0, 24.5],  # Fila 0: Sensor 1
    [31.0, 32.5, 30.0],  # Fila 1: Sensor 2
    [27.0, 26.5, 28.0]   # Fila 2: Sensor 3
])

# Lista vacía donde vamos a guardar los objetos sensores que fabriquemos
lista_sensores = []

# Recorremos las filas de la matriz utilizando un range() basado en el largo de la matriz
for i in range(len(mediciones_matriz)):
    # Fabricamos un objeto Sensor nuevo por cada fila dándole un nombre dinámico
    nombre_sensor = f"Sensor_{i + 1}"
    nuevo_objeto_sensor = Sensor(nombre_sensor)
    
    # Extraemos el renglón entero de temperaturas de la fila actual 'i'
    fila_temperaturas = mediciones_matriz[i]
    
    # Registramos cada temperatura de la fila adentro de nuestro objeto
    for valor_temperatura in fila_temperaturas:
        nuevo_objeto_sensor.registrar_medicion(valor_temperatura)
        
    # Guardamos el objeto sensor ya cargado adentro de nuestra lista general
    lista_sensores.append(nuevo_objeto_sensor)

# Recorremos la lista de sensores para mostrar en pantalla el estado final de cada uno
for s in lista_sensores:
    print(s.devolver_estado())
